package rules;

import myapp.model.Place;
import myapp.model.PlaceRating;
import myapp.model.User;

global java.util.Map placeScores;
global java.util.Map placeReasons;
global User currentUser;

// Rule: if place hashtag matches user's liked post hashtags or user's ratings/comments hashtags -> +3
rule "Match hashtag preference"
when
    $p : Place($id : id, $hashtag : hashtag) 
    eval($hashtag != null && currentUser != null && currentUser.getId() != null)
then
    try {
        String hs = $hashtag.toLowerCase();
        Double prev = (Double) placeScores.get($id);
        if (prev == null) prev = 0.0;
        // simple boost for matching hashtag substring with user's address or name - placeholder
        if (currentUser.getAddress() != null && currentUser.getAddress().toLowerCase().contains(hs)) {
            prev += 2.0;
            placeReasons.put($id, "local_hashtag_match");
        }
        placeScores.put($id, prev);
    } catch (Exception e) {
        System.out.println("ads.drl: error in Match hashtag preference: " + e.getMessage());
    }
end

// Rule: prefer places of types user liked before (based on place ratings)
rule "Prefer liked place types"
when
    $p : Place($id : id, $type : type)
    $r : PlaceRating(placeId == $id, rating >= 4)
then
    try {
        Double prev = (Double) placeScores.get($id);
        if (prev == null) prev = 0.0;
        prev += 1.5;
        placeScores.put($id, prev);
        placeReasons.put($id, "high_rating");
    } catch (Exception e) {
        System.out.println("ads.drl: error in Prefer liked place types: " + e.getMessage());
    }
end

// Rule: if user rated same place type highly before -> boost similar places
rule "Boost by user preferred place type"
when
    $u : User($uid : id)
    $r : PlaceRating(userId == $uid, rating >= 4, $pid : placeId)
    $p : Place($id : id, $type : type) 
    eval($p.getId() != $pid)
then
    try {
        // naive: if user rated a place highly, boost others (same type assumed by string match)
        Double prev = (Double) placeScores.get($p.getId());
        if (prev == null) prev = 0.0;
        prev += 2.0;
        placeScores.put($p.getId(), prev);
        placeReasons.put($p.getId(), "preferred_type");
    } catch (Exception e) {
        System.out.println("ads.drl: error in Boost by user preferred place type: " + e.getMessage());
    }
end

// Rule: boost places with good average rating
rule "Boost by average rating"
when
    $p : Place($id : id)
    $count : Number() from accumulate(
        PlaceRating(placeId == id, $r : rating),
        average($r)
    )
    eval($count != null && $count.doubleValue() >= 4.0)
then
    try {
        Double prev = (Double) placeScores.get($p.getId());
        if (prev == null) prev = 0.0;
        prev += 2.5;
        placeScores.put($p.getId(), prev);
        placeReasons.put($p.getId(), "avg_high_rating");
    } catch (Exception e) {
        System.out.println("ads.drl: error in Boost by average rating: " + e.getMessage());
    }
end

// Final cap: ensure non-negative and small boost for all
rule "Default small boost"
when
    $p : Place($id : id)
then
    try {
        Double prev = (Double) placeScores.get($p.getId());
        if (prev == null) prev = 0.1;
        placeScores.put($p.getId(), prev);
        if (!placeReasons.containsKey($p.getId())) placeReasons.put($p.getId(), "default");
    } catch (Exception e) {
        System.out.println("ads.drl: error in Default small boost: " + e.getMessage());
    }
end

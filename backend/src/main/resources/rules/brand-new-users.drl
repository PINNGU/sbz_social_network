package rules;
import myapp.model.Post;
import myapp.model.User;
import myapp.util.RecommendationAgent;
import java.util.*;

// This ruleset is for brand new users: no friends, no posts created
// It is the least important (lowest salience)
// A post can be recommended if:
// 1. It was liked by similar users (Pearson >= 0.5)


global java.util.List filteredPosts;
global java.util.Map postReasons;

rule "Brand new user: recommend posts by similar users or post similarity"
salience 1
when
    $currentUser : User($myId : id, friends.size == 0)
    not (Post(user.id == $myId)) // No posts created
    $post : Post($postId : id, $postLikes : likes, $postDate : dateOfCreation, $postUserId : user.id)
    eval(!$myId.equals($postUserId))
    eval(!filteredPosts.contains($post))
then
    int points = 0;
    // 1. Liked by similar users (Pearson >= 0.5)
    java.util.List users = RecommendationAgent.getAllUsers();
    for (int i = 0; i < $postLikes.size(); i++) {
        Long likerId = (Long) $postLikes.get(i);
        if (likerId.equals($myId)) continue;
        for (int j = 0; j < users.size(); j++) {
            User liker = (User) users.get(j);
            if (liker.getId().equals(likerId)) {
                double pearson = RecommendationAgent.pearsonSimilarity($currentUser, liker);
                if (pearson >= 0.5) {
                    points++;
                    break;
                }
            }
        }
    }
    //  Similar to a post the user has liked (>=70% overlap in likers, excluding current user)
    java.util.List posts = RecommendationAgent.getAllPosts();
    for (int i = 0; i < posts.size(); i++) {
        Post likedPost = (Post) posts.get(i);
        if (likedPost.getLikes().contains($myId)) {
            double overlap = RecommendationAgent.postSimilarity($postId, likedPost.getId(), $myId);
            if (overlap >= 0.5) {  // this should be 70%, for showcase 50% ( test with 60% too)
                points++;
                break;
            }
        }
    }
    if (points > 0) {
        filteredPosts.add($post);
        if (!postReasons.containsKey($postId)) {
            postReasons.put($postId, new java.util.HashSet<String>());
        }
        java.util.Set reasons = (java.util.Set)postReasons.get($postId);
        reasons.clear();
        reasons.add("Because you and others liked similar content");
    }
end


package rules;
import myapp.model.Post;
import myapp.model.User;
import myapp.util.RecommendationAgent;
import java.util.*;
global java.util.List filteredPosts;
global java.util.Map postReasons;


//  for brand new users: no friends, no posts created
// a post can be recommended if it was liked by similar users (Pearson > 0.5) - should be

rule "Brand new user: recommend posts liked by similar users"
salience 10
when
    $currentUser : User($myId : id, friends.size == 0)
    not (Post(user.id == $myId)) // No posts created
    $post : Post($postId : id, $postLikes : likes, $postUserId : user.id, likes.size > 0)
    eval(!$myId.equals($postUserId))
    eval(!filteredPosts.contains($post))
then
    java.util.List allUsers = RecommendationAgent.getAllUsers();
    boolean found = false;
    for (Object likerIdObj : $postLikes) {
        Long likerId = (Long) likerIdObj;
        if (likerId.equals($myId)) continue;
        for (Object userObj : allUsers) {
            User liker = (User) userObj;
            if (liker.getId().equals(likerId)) {
                double pearson = RecommendationAgent.pearsonSimilarity($currentUser, liker);
                System.out.println("[Drools DEBUG] User " + $myId + " vs " + likerId + " (post " + $postId + "): Pearson=" + pearson);
                if (pearson > -0.15) {   //for testing only , user 7 and 5 are most similar - but still not positive
                    found = true;
                    break;
                }
            }
        }
        if (found) break;
    }
    if (found) {
        filteredPosts.add($post);
        if (!postReasons.containsKey($postId)) {
            postReasons.put($postId, new java.util.HashSet<String>());
        }
        java.util.Set reasons = (java.util.Set)postReasons.get($postId);
        reasons.clear();
        reasons.add("similar_user");
    }
end


//recommend posts similar to those the user has liked (by overlap in likers)
rule "Brand new user: recommend posts similar to liked posts"
salience 5
when
    $currentUser : User($myId : id, friends.size == 0)
    not (Post(user.id == $myId)) // No posts created
    $post : Post($postId : id, $postUserId : user.id)
    eval(!$myId.equals($postUserId))
    eval(!filteredPosts.contains($post))
then
    java.util.List posts = RecommendationAgent.getAllPosts();
    boolean found = false;
    for (int i = 0; i < posts.size(); i++) {
        myapp.model.Post likedPost = (myapp.model.Post) posts.get(i);
        if (likedPost.getLikes().contains($myId)) {
            double overlap = RecommendationAgent.postSimilarity($postId, likedPost.getId(), $myId);
            if (overlap >= 0.6) {
                found = true;
                break;
            }
        }
    }
    if (found) {
        filteredPosts.add($post);
        if (!postReasons.containsKey($postId)) {
            postReasons.put($postId, new java.util.HashSet<String>());
        }
        java.util.Set reasons = (java.util.Set)postReasons.get($postId);
        reasons.clear();
        reasons.add("similar_content");
    }
end
